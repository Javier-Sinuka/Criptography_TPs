FROM hardy-base:ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    lynis openssh-server redis-server sudo iproute2 procps ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
RUN useradd --create-home --shell /bin/bash auditor \
    && mkdir -p /run/sshd /home/auditor/.ssh /evidencias \
    && chmod 700 /home/auditor/.ssh \
    && chown -R auditor:auditor /home/auditor/.ssh
COPY sshd-lab.conf /etc/ssh/sshd_config.d/10-laboratorio.conf
COPY sudoers-auditor /etc/sudoers.d/auditor
RUN chmod 440 /etc/sudoers.d/auditor
CMD ["/usr/sbin/sshd", "-D", "-e"]
